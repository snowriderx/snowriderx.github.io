# Copy to .env and fill in values. Never commit .env.

FLASK_ENV=development

# PostgreSQL connection string
DATABASE_URL=postgresql://snowriderx:password@localhost:5432/snowriderx_pg

SECRET_KEY=change-me-to-a-random-secret

SITE_NAME=Snow Rider X

# Production: set to "true" (HTTPS only cookies)
COOKIE_SECURE=false

# Upload settings
UPLOAD_FOLDER=admin/static/uploads
MAX_CONTENT_LENGTH_MB=10
UPLOAD_MAX_FILE_MB=5
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,gif,png,webp

# Remote image storage (leave blank to use local filesystem)
IMAGE_BASE_URL=
UPLOAD_API_URL=
UPLOAD_API_KEY=

# Rate limiting
# Development: memory:// is fine (single process)
# Production: MUST use Redis — memory:// shares nothing between gunicorn workers,
#   so brute-force limits are multiplied by worker count (e.g. 3 workers = 3x the limit).
#   Install Redis: apt install redis-server  (or brew install redis on Mac)
#   Then set: RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
RATELIMIT_LOGIN=5 per minute;20 per hour
RATELIMIT_CHANGE_PW=5 per minute
RATELIMIT_MUTATION=30 per minute
